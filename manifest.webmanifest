{
  "id": "/strength-log/",
  "name": "Strength Log",
  "short_name": "Strength Log",
  "description": "A simple strength training progress tracker.",
  "start_url": "/strength-log/",
  "scope": "/strength-log/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#101010",
  "theme_color": "#101010",
  "orientation": "portrait-primary",
  "prefer_related_applications": false,
  "icons": [
    {"src": "/strength-log/icon-192.svg","sizes":"192x192","type":"image/svg+xml","purpose":"any maskable"},
    {"src": "/strength-log/icon-512.svg","sizes":"512x512","type":"image/svg+xml","purpose":"any maskable"}
  ]
}