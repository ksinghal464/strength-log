{
  "id": "/strength-log/",
  "name": "Strength Log",
  "short_name": "Strength Log",
  "description": "A simple strength training progress tracker.",
  "start_url": "/strength-log/",
  "scope": "/strength-log/",
  "display": "standalone",
  "display_override": [
    "standalone"
  ],
  "background_color": "#101010",
  "theme_color": "#101010",
  "orientation": "portrait-primary",
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/strength-log/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/strength-log/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/strength-log/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/strength-log/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}